{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["dom", "es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node16",
    "isolatedModules": true
  }
}
